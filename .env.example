# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Yahoo authentication ---
# OAuth2 credentials file (reads: get_team, rosters, player lookups).
YAHOO_CREDS_FILE=

# Cookie + crumb write transport (writes: add/drop/replace, waivers, lineups).
# Yahoo app tokens are read-only, so writes impersonate a logged-in browser
# session. Harvest these manually from your browser; they expire periodically.
YAHOO_COOKIE=
YAHOO_CRUMB=

# Force reads onto the cookie transport, skipping the startup OAuth probe.
# Set this (1/true/yes/on) when OAuth reads are known-gated by Yahoo so the app
# doesn't pay for a guaranteed-failing probe each run. Leave blank otherwise.
YAHOO_FORCE_COOKIE_READS=

# --- General ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL (defaults to INFO).
LOG_LEVEL=INFO
# Season directory under config/data/season (defaults to 2026_2027).
FANTASY_SEASON=2026_2027
YEAR=2026

# --- Timed transaction execution (optional; defaults shown) ---
# Seconds before the target time to wake, re-auth, and validate inputs.
PRE_FLIGHT_CHECK_SECS=30
# Seconds before the target time the first write fires (so the retry loop is
# already hammering as the transaction window opens).
FIRE_EARLY_BUFFER_SECS=0.2
# --- Add-player retry loop (optional; defaults shown) ---
TIMEOUT_SECONDS=15
POLL_SECONDS=0.1
DEFAULT_PLAYER_RANK=70

# --- News alerts (optional; feature not yet wired up) ---
# Bluesky source account + app password and the list URI to monitor.
BLUESKY_HANDLE=your-handle.bsky.social
BLUESKY_APP_PASSWORD=
BLUESKY_LIST_URI=at://did:plc:xxxx/app.bsky.graph.list/yyyy
# SMTP transport for emailed news alerts, plus the recipient address.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NEWS_ALERT_EMAIL=you@example.com
