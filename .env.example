# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

# --- Yahoo authentication ---
# OAuth2 credentials file (reads: get_team, rosters, player lookups).
YAHOO_CREDS_FILE=

# Cookie + crumb write transport (writes: add/drop/replace, waivers, lineups).
# Yahoo app tokens are read-only, so writes impersonate a logged-in browser
# session. Harvest these manually from your browser; they expire periodically.
YAHOO_COOKIE=
YAHOO_CRUMB=

# --- General ---
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL (defaults to INFO).
LOG_LEVEL=INFO
# Season directory under config/data/season (defaults to 2025_2026).
FANTASY_SEASON=2025_2026
YEAR=2024

# --- Add-player retry loop (optional; defaults shown) ---
TIMEOUT_SECONDS=15
POLL_SECONDS=0.1
DEFAULT_PLAYER_RANK=70
